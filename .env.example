# FinGuard AI — Environment Variables
# Copy this file to .env and fill in your values

# --- Database ---
DATABASE_URL=postgresql://finguard:finguard_secret@localhost:5432/finguard_db

# --- Security ---
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Model ---
MODEL_PATH=models/production

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- For Docker Compose (db service) ---
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard_secret
POSTGRES_DB=finguard_db
